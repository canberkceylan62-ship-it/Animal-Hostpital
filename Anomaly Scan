-- --------------------------------------------------------------------
-- SCANNER LOGIC
-- --------------------------------------------------------------------
local function applyHighlight(model, isAnomaly)
    local existing = model:FindFirstChild("AnomalyScanHighlight")
    if existing then existing:Destroy() end

    local highlight = Instance.new("Highlight")
    highlight.Name = "AnomalyScanHighlight"
    highlight.Adornee = model
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    if isAnomaly then
        highlight.FillColor = COLOR_ANOMALY
        highlight.OutlineColor = COLOR_ANOMALY
    else
        highlight.FillColor = COLOR_NORMAL
        highlight.OutlineColor = COLOR_NORMAL
    end

    highlight.Parent = model

    task.delay(HIGHLIGHT_DURATION, function()
        if highlight and highlight.Parent then
            local tween = TweenService:Create(highlight, TweenInfo.new(1), {FillTransparency = 1, OutlineTransparency = 1})
            tween:Play()
            tween.Completed:Connect(function()
                highlight:Destroy()
            end)
        end
    end)
end

local function runScan()
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local origin = character.HumanoidRootPart.Position

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Model") and object:FindFirstChildOfClass("Humanoid") and object ~= character then
            local primaryPart = object.PrimaryPart or object:FindFirstChild("HumanoidRootPart") or object:FindFirstChild("Head") or object:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                local distance = (primaryPart.Position - origin).Magnitude
                if distance <= SCAN_RADIUS then
                    local isAnomaly = checkIsAnomaly(object)
                    applyHighlight(object, isAnomaly)
                end
            end
        end
    end
end

scanButton.MouseButton1Click:Connect(runScan)

