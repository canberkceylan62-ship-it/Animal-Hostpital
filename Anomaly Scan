local HIGHLIGHT_DURATION = 5                  -- Seconds highlight stays active

-- Function to check if the camera feed or viewport is showing a Void Body / Shadow Anomaly
local function isCCTVVoidAnomaly(npcModel)
    -- 1. Check for dedicated CCTV viewport models or camera clones
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("ViewportFrame") and gui.Visible then
            for _, clone in ipairs(gui:GetDescendants()) do
                if clone:IsA("BasePart") and clone.Transparency < 1 then
                    -- If the camera view shows pitch-black parts while standing at desk
                    if clone.Color.R < 0.05 and clone.Color.G < 0.05 and clone.Color.B < 0.05 then
                        return true
                    end
                end
            end
        end
    end

    -- 2. Check for hidden black overlay meshes/parts welded to NPC for camera views
    for _, part in ipairs(npcModel:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("SpecialMesh") then
            local pColor = part:IsA("BasePart") and part.Color or (part:IsA("SpecialMesh") and part.VertexColor)
            if pColor then
                if (part.Name:lower():find("cctv") or part.Name:lower():find("shadow") or part.Name:lower():find("void")) then
                    return true
                end
            end
        end
    end

    return false
end

-- Comprehensive Anomaly Checker (Physical, CCTV, and Internal Flags)
local function checkIsAnomaly(npcModel)
    -- Check 1: Camera Feed / Void Body Anomaly
    if isCCTVVoidAnomaly(npcModel) then
        return true
    end

    -- Check 2: CollectionService Tags
    for _, tag in ipairs(CollectionService:GetTags(npcModel)) do
        local tagLower = tag:lower()
        if tagLower:find("anomaly") or tagLower:find("fake") or tagLower:find("skinwalker") or tagLower:find("void") then
            return true
        end
    end

    -- Check 3: Attributes across Model & Children
    for _, obj in ipairs({npcModel, unpack(npcModel:GetDescendants())}) do
        if obj:IsA("Instance") then
            for attrName, attrVal in pairs(obj:GetAttributes()) do
                local nameLower = attrName:lower()
                if nameLower:find("anomaly") or nameLower:find("fake") or nameLower:find("void") or nameLower:find("shadow") then
                    if attrVal == true or tostring(attrVal):lower() == "true" then return true end
                end
                if nameLower:find("real") or nameLower:find("normal") or nameLower:find("human") then
                    if attrVal == false or tostring(attrVal):lower() == "false" then return true end
                end
            end
        end
    end

    -- Check 4: Value Objects (BoolValue, StringValue)
    for _, descendant in ipairs(npcModel:GetDescendants()) do
        if descendant:IsA("ValueBase") then
            local nameLower = descendant.Name:lower()
            local valStr = tostring(descendant.Value):lower()
            if nameLower:find("anomaly") or nameLower:find("fake") or nameLower:find("isvoid") then
                if descendant:IsA("BoolValue") and descendant.Value == true then return true end
                if valStr == "true" or valStr:find("anomaly") then return true end
            end
            if nameLower:find("real") and descendant:IsA("BoolValue") and descendant.Value == false then
                return true
            end
        end
    end

    -- Check 5: Model / Instance Name
    local modelName = npcModel.Name:lower()
    if modelName:find("anomaly") or modelName:find("fake") or modelName:find("skinwalker") or modelName:find("shadow") then
        return true
    end

    return false
end

